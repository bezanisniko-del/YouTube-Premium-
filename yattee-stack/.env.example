# Environment for the docker-compose fallback (see docker-compose.yml).
# Not used by the Home Assistant add-on — that reads its settings from the
# add-on Configuration tab instead.
#
# Copy to .env and fill in. .env is gitignored; never commit real secrets.
#   cp .env.example .env
#
# Every variable below is read by yattee-server's config.py unless noted.

# ---------------------------------------------------------------------------
# Admin account (auto-provisioning)
# ---------------------------------------------------------------------------
# When both are set, env_provisioning.py:28-45 creates the admin on first start
# and resets its password on every subsequent start. This is what makes the
# deploy reproducible: no clicking through the /setup wizard.
#
# These are also the HTTP Basic Auth credentials Yattee will ask for on the
# phone. Basic Auth is enforced on every path once any user exists
# (basic_auth.py:154-160).
#
# Generate a password locally, do not reuse one:
#   openssl rand -base64 24
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Backing Invidious instance (optional)
# ---------------------------------------------------------------------------
# Leave EMPTY. Recommendation and evidence in DECISIONS.md D4.
#
# Set it and env_provisioning.py:48-59 enables the Invidious proxy, which adds
# trending, popular, comments, and fallbacks for captions/thumbnails/avatars.
# Video, search and channels all work without it via InnerTube + yt-dlp.
# Validate any candidate with ./probe-invidious.sh before adopting it.
INVIDIOUS_INSTANCE_URL=

# ---------------------------------------------------------------------------
# yt-dlp currency (read by the compose command, not by config.py)
# ---------------------------------------------------------------------------
# latest             — upgrade to newest yt-dlp on every container start (default)
# skip               — use whatever the pinned image ships
# 2026.07.04         — pin an explicit release; use this to roll back after a
#                      bad yt-dlp release breaks extraction
# See DECISIONS.md D3.
YTDLP_VERSION=latest

# uvicorn log level: trace|debug|info|notice|warning|error|fatal
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Data and downloads
# ---------------------------------------------------------------------------
# Database and encryption keys. Backed by the `data` named volume in compose.
DATA_DIR=/app/data

# Proxied video downloads. Mounted as tmpfs in compose, so this is RAM-backed
# and disposable.
DOWNLOAD_DIR=/downloads

# ---------------------------------------------------------------------------
# Credential encryption
# ---------------------------------------------------------------------------
# Encrypts per-site credentials (cookies, API keys) at rest. Auto-generated
# into DATA_DIR if unset, which is fine for a single host. Set it explicitly
# only if you need the same key across rebuilds where DATA_DIR is not preserved.
# Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CREDENTIALS_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
# HTTP/SOCKS proxy for YouTube-bound traffic (yt-dlp, InnerTube, Invidious).
# Only relevant if your ISP address gets rate-limited by YouTube.
# YT_EGRESS_PROXY=socks5://host:port

# Extra CIDRs allowed through the SSRF guard (config.py:61-70). Needed ONLY if
# INVIDIOUS_INSTANCE_URL points at a LAN address that returns stream URLs on
# private IPs. Not needed for a public HTTPS instance, and not needed at all
# with the recommended empty INVIDIOUS_INSTANCE_URL. Loopback stays blocked
# regardless of what you put here.
# SSRF_EXTRA_ALLOWED_CIDRS=192.168.1.0/24

# ---------------------------------------------------------------------------
# CORS — leave disabled
# ---------------------------------------------------------------------------
# Yattee is a native app and sends no Origin header, so none of this is needed.
# Only relevant if you plan to drive the API from a browser page.
# CORS_ORIGINS=https://example.com
# CORS_ALLOW_ALL=true
# CORS_ALLOW_CREDENTIALS=true

# ---------------------------------------------------------------------------
# Not worth setting
# ---------------------------------------------------------------------------
# DEBUG=false                  # uvicorn auto-reload; development only
# YTDLP_SKIP_TLS_VERIFY=false  # leave false
# SECURE_COOKIES=true          # dead config: config.py:37 reads it, nothing
#                              # else in the codebase uses it. See DECISIONS.md.
